options:
  parameters:
    author: Grupo 6 - Juan Pablo Moreno Peña; Juan David Ruiz Higuera
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    description: Mismo Tx/Rx del grupo; el SDR se reemplaza por una conexión directa y e_EbN0_Sweep agrega el AWGN.
    generate_options: qt_gui
    id: G6_BFSK_BER_Simulacion
    title: Grupo 6 - Curva BER vs Eb/N0 BFSK (simulación)
    output_language: python
    placement: (0,0)
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    window_size: (1500,900)
    max_nouts: '0'
    realtime_scheduling: ''
    qt_qss_theme: ''
    thread_safe_setters: ''
    hier_block_src_path: '.:'
    copyright: ''
    gen_linking: dynamic
    gen_cmake: 'On'
    cmake_opt: ''
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
