options:
  parameters:
    author: Grupo 6 - Juan Pablo Moreno Peña; Juan David Ruiz Higuera
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    description: Osmocom Source -> desplazamiento -> Rational Resampler 1/2 -> receptor BFSK del grupo.
    generate_options: qt_gui
    id: G6_BFSK_HackRF_Rx
    title: Grupo 6 - Receptor BFSK con HackRF One
    output_language: python
    placement: (0,0)
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    window_size: (1500,900)
    max_nouts: '0'
    realtime_scheduling: ''
    qt_qss_theme: ''
    thread_safe_setters: ''
    hier_block_src_path: '.:'
    copyright: ''
    gen_linking: dynamic
    gen_cmake: 'On'
    cmake_opt: ''
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: import_math
  id: import
  parameters:
    imports: 'import math

      from gnuradio.filter import firdes'
  states:
    coordinate:
    - 220
    - 8
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: fs = Rs*SPS = 10000*100 (paquete C, GRC base FSK)
    value: 1e6
  states:
    coordinate:
    - 450
    - 8
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '100'
  states:
    coordinate:
    - 680
    - 8
    rotation: 0
    state: enabled
- name: symbol_rate
  id: variable
  parameters:
    comment: Rs = 10 kBd (fija; selector guiado S5)
    value: samp_rate/sps
  states:
    coordinate:
    - 910
    - 8
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: 'BFSK binaria: Rb = Rs'
